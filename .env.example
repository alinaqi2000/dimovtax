# Database (local Docker postgres)
DATABASE_URL="postgresql://dimovtax:dimovtax@localhost:5432/dimovtax?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-in-production-9f3a1c7b2e8d4a6f"

# Auth.js — set to true when running behind a proxy in production
AUTH_TRUST_HOST="true"
